<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ClientAppDirectory>ClientApp/</ClientAppDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Scalar.AspNetCore" Version="2.12.35" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SftpSync.Business\SftpSync.Business.csproj" />
    <ProjectReference Include="..\SftpSync.Infrastructure\SftpSync.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="$(ClientAppDirectory)node_modules/**" />
  </ItemGroup>

  <Target Name="BuildClientApp" BeforeTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(ClientAppDirectory)" Command="npm ci" />
    <Exec WorkingDirectory="$(ClientAppDirectory)" Command="npm run build" />
    <ItemGroup>
      <DistFiles Include="wwwroot/**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
