amends "elide:project.pkl"

import "elide:Sources.pkl" as Sources

local springBootVersion = "4.1.1"
local kotlinVersion = "2.4.20"
local jacksonVersion = "3.1.5"
local testcontainersVersion = "2.0.5"
local postgresDriverVersion = "42.7.13"
local jnaVersion = "5.18.1"
local sshjVersion = "0.40.0"
local slf4jVersion = "2.0.18"
local development = build.flags.bool("DEV")

name = "sporesync-backend"

jvm {
  main = "dev.sporesync.ApplicationKt"
  target = 25
}
kotlin {
  compilerOptions {
    jvmTarget = 25
    allWarningsAsErrors = true
    freeCompilerArgs { "-Xjsr305=strict" }
  }
}
sources {
  ["main"] = new Sources.SourceSetSpec {
    paths { "src/main/kotlin/**/*.kt" }
  }
  ["test"] = new Sources.SourceSetSpec {
    type = "test"
    dependsOn { "main" }
    paths { "src/test/kotlin/**/*.kt" }
  }
}
dependencies {
  maven {
    packages {
      "org.springframework.boot:spring-boot-starter-webmvc:\(springBootVersion)"
      "org.springframework.boot:spring-boot-starter-validation:\(springBootVersion)"
      "org.springframework.boot:spring-boot-starter-data-jpa:\(springBootVersion)"
      "org.springframework.boot:spring-boot-starter-liquibase:\(springBootVersion)"
      // Keep logging aligned with Boot when transitive dependencies request SLF4J 1.x.
      "org.slf4j:slf4j-api:\(slf4jVersion)"
      "org.jetbrains.kotlin:kotlin-reflect:\(kotlinVersion)"
      "tools.jackson.module:jackson-module-kotlin:\(jacksonVersion)"
      "net.java.dev.jna:jna:\(jnaVersion)"
      "com.hierynomus:sshj:\(sshjVersion)"
    }
    runtimeOnly {
      "org.postgresql:postgresql:\(postgresDriverVersion)"
      when (development) {
        "org.springframework.boot:spring-boot-devtools:\(springBootVersion)"
      }
    }
    testPackages {
      "org.springframework.boot:spring-boot-starter-webmvc-test:\(springBootVersion)"
      "org.springframework.boot:spring-boot-testcontainers:\(springBootVersion)"
      "org.testcontainers:testcontainers-junit-jupiter:\(testcontainersVersion)"
      "org.testcontainers:testcontainers-postgresql:\(testcontainersVersion)"
    }
  }
}
