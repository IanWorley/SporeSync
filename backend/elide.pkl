amends "elide:project.pkl"
import "elide:Kotlin.pkl" as Kotlin
import "../tools/LintTools.pkl"

name = "sporesync-backend"
description = "SporeSync backend: Kotlin, Spring Boot, Spring Modulith."

local springBootVersion = "4.1.1"
local springModulithVersion = "2.1.1"
local kotlinVersion = "2.4.21"
// Matches `jackson.version.annotations` in the Jackson 3 BOM that Spring Boot uses.
local jacksonAnnotationsVersion = "2.21"
// Matches `h2.version` in the Spring Boot BOM.
local h2Version = "2.4.240"

// Paths in LintTools are relative to the workspace root, one level up.
local workspaceRoot = ".."
local kotlinSources = "'src/**/*.kt'"

// Elide has no custom build tasks, so ktlint and detekt run as scripts on Elide's JVM.
// Each exits non-zero on a violation, so CI (#6) can run them as separate checks.
scripts {
  ["format-check"] = "elide java -- -jar \(workspaceRoot)/\(LintTools.ktlintJar) \(kotlinSources)"
  ["format"] = "elide java -- -jar \(workspaceRoot)/\(LintTools.ktlintJar) --format \(kotlinSources)"
  ["lint"] = "elide java -- -jar \(workspaceRoot)/\(LintTools.detektJar) --input src"
}

jvm {
  main = "com.sporesync.SporeSyncApplicationKt"
}

kotlin {
  features {
    // Spring provides DI and serialization; skip Elide's Metro and KotlinX defaults.
    kotlinx = false
    metro = false
  }
  // A managed toolchain is required for the all-open (Spring) compiler plugin; the embedded
  // compiler does not apply third-party plugins.
  toolchain = new Kotlin.ManagedKotlinToolchain { version = kotlinVersion }
  plugins {
    ["org.jetbrains.kotlin.allopen"] {
      ["preset"] = "spring"
    }
    ["org.jetbrains.kotlin.noarg"] {
      ["preset"] = "jpa"
    }
  }
}

dependencies {
  spring {
    version = springBootVersion
    starter { "web"; "actuator"; "data-jpa"; "liquibase" }
    testStarter { "test" }
  }
  maven {
    packages {
      "org.springframework.modulith:spring-modulith-starter-core:\(springModulithVersion)"
      "com.h2database:h2:\(h2Version)"
    }
    testPackages {
      "org.springframework.modulith:spring-modulith-starter-test:\(springModulithVersion)"
      // Modulith docs pull in Structurizr, which pins jackson-annotations 2.20. Elide resolves nearest-first
      // without Spring Boot's BOM, so pin the version Jackson 3 needs or Spring's JSON converters fail to load.
      "com.fasterxml.jackson.core:jackson-annotations:\(jacksonAnnotationsVersion)"
    }
    kotlinPlugins {
      "org.jetbrains.kotlin:kotlin-allopen-compiler-plugin:\(kotlinVersion)"
      "org.jetbrains.kotlin:kotlin-noarg-compiler-plugin:\(kotlinVersion)"
    }
  }
}
