amends "elide:project.pkl"

name = "sporesync"

// Elide workspace root. `elide build` and `elide test` here cover every member.
// The frontend is not a member: Elide 1.6.0 neither installs a member's npm dependencies
// nor runs Vite, Vitest, ESLint, or Prettier, so `frontend/` installs and runs them itself.
workspace {
  members {
    "backend"
    "tools"
  }
}
