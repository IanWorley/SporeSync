{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Microsoft\\./"
      ],
      "groupName": "Microsoft NuGet packages"
    },
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "coverlet.collector",
        "Microsoft.NET.Test.Sdk",
        "xunit",
        "xunit.runner.visualstudio"
      ],
      "groupName": "test NuGet packages"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@types\\//",
        "typescript",
        "typescript-eslint"
      ],
      "groupName": "TypeScript packages"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchPackageNames": [
        "/^@tanstack\\//"
      ],
      "groupName": "TanStack packages"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions"
    }
  ]
}
